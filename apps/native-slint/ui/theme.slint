import { Palette } from "std-widgets.slint";

// One role set per accent and appearance. Every authored surface and control
// reads these tokens; none takes a colour from the toolkit style.
export struct Tokens {
    paper: color, surface: color, sunken: color, wash: color,
    ink: color, muted: color, border: color, field-border: color,
    accent: color, accent-strong: color, on-accent: color,
    shell: color, shell-ink: color, shell-muted: color, shell-control: color,
    error: color, error-bg: color,
}

export global Theme {
    // 0 evergreen, 1 tangerine, 2 ocean, 3 berry.
    in-out property <int> accent-index: 0;
    // 0 follows the system, 1 light, 2 dark.
    in-out property <int> appearance: 0;
    in property <bool> reduce-motion;
    out property <bool> dark: appearance == 2 || (appearance == 0 && Palette.color-scheme == ColorScheme.dark);
    out property <duration> quick: reduce-motion ? 0ms : 120ms;
    out property <duration> settle: reduce-motion ? 0ms : 220ms;

    property <[Tokens]> lights: [
        {
            paper: #f6f4ef, surface: #ffffff, sunken: #e9eee8, wash: #e3f0e8,
            ink: #192821, muted: #59645e, border: #d8ddd6, field-border: #78867b,
            accent: #22624e, accent-strong: #174737, on-accent: #ffffff,
            shell: #203c33, shell-ink: #ffffff, shell-muted: #cbd7cf, shell-control: #2f4f44,
            error: #a3302a, error-bg: #fff1ed,
        },
        {
            paper: #f8f3ec, surface: #ffffff, sunken: #f1e6da, wash: #fbe9d6,
            ink: #2a1d15, muted: #6b5c52, border: #e2d8cd, field-border: #8d7b6c,
            accent: #984414, accent-strong: #76320f, on-accent: #ffffff,
            shell: #492e20, shell-ink: #ffffff, shell-muted: #eed6c7, shell-control: #5f3f2e,
            error: #a3302a, error-bg: #fff1ed,
        },
        {
            paper: #f2f5f7, surface: #ffffff, sunken: #e2ebf0, wash: #dcedf6,
            ink: #14252e, muted: #53626b, border: #d3dce1, field-border: #71848f,
            accent: #176587, accent-strong: #104d68, on-accent: #ffffff,
            shell: #183c50, shell-ink: #ffffff, shell-muted: #ccdee9, shell-control: #275068,
            error: #a3302a, error-bg: #fff1ed,
        },
        {
            paper: #f6f2f6, surface: #ffffff, sunken: #ece3ee, wash: #f3e4f5,
            ink: #251a29, muted: #655a68, border: #dfd5e0, field-border: #877689,
            accent: #7d3984, accent-strong: #612b67, on-accent: #ffffff,
            shell: #422d49, shell-ink: #ffffff, shell-muted: #e5d4e9, shell-control: #573d60,
            error: #a3302a, error-bg: #fff1ed,
        },
    ];
    property <[Tokens]> darks: [
        {
            paper: #111815, surface: #18211d, sunken: #1f2b26, wash: #1d362c,
            ink: #e6ede8, muted: #a1b0a8, border: #2c3a34, field-border: #6a8176,
            accent: #6fcfab, accent-strong: #8fdcbf, on-accent: #0b241b,
            shell: #0c1310, shell-ink: #e6ede8, shell-muted: #9fb4aa, shell-control: #1b2823,
            error: #ff9b90, error-bg: #3a1a17,
        },
        {
            paper: #1a1410, surface: #231b15, sunken: #2e231b, wash: #3c2a1b,
            ink: #f1e7de, muted: #b8a698, border: #3d3027, field-border: #8b7462,
            accent: #f0a36b, accent-strong: #f6b98c, on-accent: #2c1505,
            shell: #130e0b, shell-ink: #f1e7de, shell-muted: #b9a596, shell-control: #2a2019,
            error: #ff9b90, error-bg: #3a1a17,
        },
        {
            paper: #0f171c, surface: #162127, sunken: #1d2b33, wash: #183545,
            ink: #e2ecf1, muted: #9db0ba, border: #2a3a44, field-border: #668092,
            accent: #6cc0e4, accent-strong: #8fd1ee, on-accent: #062230,
            shell: #0a1115, shell-ink: #e2ecf1, shell-muted: #9cb2be, shell-control: #18262e,
            error: #ff9b90, error-bg: #3a1a17,
        },
        {
            paper: #18121a, surface: #211923, sunken: #2b212e, wash: #38233d,
            ink: #efe5f1, muted: #b3a3b7, border: #3a2d3e, field-border: #88728d,
            accent: #d79ade, accent-strong: #e3b6e8, on-accent: #2b0f30,
            shell: #110c13, shell-ink: #efe5f1, shell-muted: #b5a4b9, shell-control: #261d29,
            error: #ff9b90, error-bg: #3a1a17,
        },
    ];
    out property <Tokens> t: dark ? darks[clamp(accent-index, 0, 3)] : lights[clamp(accent-index, 0, 3)];

    out property <color> paper: t.paper;
    out property <color> surface: t.surface;
    out property <color> sunken: t.sunken;
    out property <color> wash: t.wash;
    out property <color> ink: t.ink;
    out property <color> muted: t.muted;
    out property <color> border: t.border;
    out property <color> field-border: t.field-border;
    out property <color> accent: t.accent;
    out property <color> accent-strong: t.accent-strong;
    out property <color> on-accent: t.on-accent;
    out property <color> shell: t.shell;
    out property <color> shell-ink: t.shell-ink;
    out property <color> shell-muted: t.shell-muted;
    out property <color> shell-control: t.shell-control;
    out property <color> error: t.error;
    out property <color> error-bg: t.error-bg;
    // Swatches for the accent picker, independent of the current appearance.
    out property <[color]> swatches: dark
        ? [darks[0].accent, darks[1].accent, darks[2].accent, darks[3].accent]
        : [lights[0].accent, lights[1].accent, lights[2].accent, lights[3].accent];
    // A QR symbol keeps dark modules on a light plate in every theme.
    out property <color> code-plate: #ffffff;
    out property <color> code-ink: #141c18;
}

export component Heading inherits Text {
    font-size: 20px;
    font-weight: 650;
    color: Theme.ink;
    wrap: word-wrap;
}

export component Label inherits Text {
    font-size: 13px;
    font-weight: 600;
    color: Theme.ink;
    wrap: word-wrap;
}

export component Body inherits Text {
    font-size: 14px;
    color: Theme.ink;
    wrap: word-wrap;
}

export component Hint inherits Text {
    font-size: 13px;
    color: Theme.muted;
    wrap: word-wrap;
}
