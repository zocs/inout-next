import { ScrollView } from "std-widgets.slint";
import { ActionButton, ButtonKind, Select } from "controls.slint";
import { Theme, Body, Hint } from "theme.slint";
import { MatrixDot, Wordmark } from "wordmark.slint";
import { Labels, Tr } from "text.slint";
import { SharingSetup } from "setup.slint";
import { EndpointRow, PermissionChip, SharePanel } from "connection.slint";
import { CodeModule } from "code.slint";
import { TransferRow, Transfers } from "transfers.slint";
import { AboutCard } from "about.slint";
export { Theme, Tr, MatrixDot, Labels, TransferRow, EndpointRow, PermissionChip, CodeModule }

export component AppWindow inherits Window {
    in property <string> product-name;
    in property <string> product-version;
    in property <string> product-description;
    in property <[MatrixDot]> wordmark-dots;
    in property <int> wordmark-columns;
    in property <bool> ready;
    in property <bool> resources-ready: true;
    in property <bool> running;
    in-out property <bool> busy;
    in-out property <bool> picker-busy;
    in property <bool> confirming;
    in property <bool> closing;
    in property <string> problem;
    in property <string> notice;
    in property <string> shared-folder;
    in property <[string]> quick-folders;
    in property <[EndpointRow]> endpoints;
    in property <string> selected-address;
    in property <string> selected-title;
    in property <bool> local-only;
    in property <bool> lan-missing;
    in property <[CodeModule]> code-modules;
    in property <int> code-side;
    in property <[PermissionChip]> permissions;
    in property <string> access-summary;
    in property <[TransferRow]> transfers;
    in-out property <int> endpoint-index;
    in-out property <int> locale-index;
    in-out property <string> folder;
    in-out property <string> port: "5000";
    in-out property <string> key;
    in-out property <bool> network: true;
    in-out property <int> access-index: 0;
    in-out property <bool> opening-visible: true;
    in-out property <float> opening-opacity: 1;
    private property <bool> about-visible;
    private property <bool> controls-enabled: ready && !confirming && !about-visible && !busy;
    private property <bool> choices-enabled: !confirming && !about-visible;
    callback start-sharing();
    callback stop-sharing();
    callback choose-folder();
    callback folder-edited();
    callback quick-folder(int);
    callback locale-selected(int);
    callback accent-selected(int);
    callback appearance-selected(int);
    callback endpoint-selected(int);
    callback copy-address();
    callback browser-result(bool);
    callback cancel-interrupt();
    callback confirm-interrupt();
    callback refresh();
    callback picker-ready();

    title: product-name;
    preferred-width: 1000px;
    preferred-height: 780px;
    min-width: 780px;
    min-height: 600px;
    background: Theme.paper;
    default-font-size: 14px;

    public function show-confirmation() { root.hide-about(); confirmation.show(); }
    public function hide-confirmation() { confirmation.close(); }
    public function focus-start() { setup.focus-start(); }
    public function focus-stop() { setup.focus-stop(); }
    public function show-about() {
        if !root.confirming {
            root.about-visible = true;
            about.show();
        }
    }
    public function hide-about() {
        if root.about-visible {
            root.about-visible = false;
            about.close();
            if !root.confirming { about-button.focus(); }
        }
    }

    VerticalLayout {
        spacing: 0;
        Rectangle {
            min-height: header.min-height;
            vertical-stretch: 0;
            background: Theme.shell;
            header := HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Wordmark {
                        name: root.product-name;
                        dots: root.wordmark-dots;
                        columns: root.wordmark-columns;
                        ink: Theme.shell-ink;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // Four header controls share one height and one centre line.
                VerticalLayout {
                    alignment: center;
                    Select {
                        width: 132px;
                        on-shell: true;
                        label: Tr.l.language;
                        model: ["English", "简体中文", "繁體中文"];
                        current-index <=> root.locale-index;
                        enabled: root.choices-enabled;
                        selected(index) => { root.locale-selected(index); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Select {
                        width: 132px;
                        on-shell: true;
                        label: Tr.l.theme;
                        model: [Tr.l.evergreen, Tr.l.tangerine, Tr.l.ocean, Tr.l.berry];
                        swatches: Theme.swatches;
                        current-index <=> Theme.accent-index;
                        enabled: root.choices-enabled;
                        selected(index) => { root.accent-selected(index); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Select {
                        width: 132px;
                        on-shell: true;
                        label: Tr.l.appearance;
                        model: [Tr.l.follow-system, Tr.l.light, Tr.l.dark];
                        current-index <=> Theme.appearance;
                        enabled: root.choices-enabled;
                        selected(index) => { root.appearance-selected(index); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    about-button := ActionButton {
                        kind: ButtonKind.shell;
                        control-height: 36px;
                        text: Tr.l.about;
                        available: root.choices-enabled;
                        activated => { root.show-about(); }
                    }
                }
            }
        }
        ScrollView {
            HorizontalLayout {
                padding: 24px;
                spacing: 24px;
                VerticalLayout {
                    spacing: 24px;
                    alignment: start;
                    horizontal-stretch: 5;
                    setup := SharingSetup {
                        enabled: root.controls-enabled && root.resources-ready;
                        running: root.running;
                        busy: root.busy || root.picker-busy;
                        problem: root.problem;
                        shared-folder: root.shared-folder;
                        quick-folders: root.quick-folders;
                        folder <=> root.folder;
                        key <=> root.key;
                        port <=> root.port;
                        network <=> root.network;
                        access-index <=> root.access-index;
                        folder-edited => { root.folder-edited(); }
                        choose-folder => { root.choose-folder(); }
                        quick-folder(index) => { root.quick-folder(index); }
                        start-sharing => { root.start-sharing(); }
                        stop-sharing => { root.stop-sharing(); }
                    }
                    Transfers { records: root.transfers; }
                }
                VerticalLayout {
                    alignment: start;
                    horizontal-stretch: 4;
                    SharePanel {
                        running: root.running;
                        enabled: root.controls-enabled;
                        code-modules: root.code-modules;
                        code-side: root.code-side;
                        endpoints: root.endpoints;
                        selected-address: root.selected-address;
                        selected-title: root.selected-title;
                        local-only: root.local-only;
                        lan-missing: root.lan-missing;
                        permissions: root.permissions;
                        access-summary: root.access-summary;
                        notice: root.notice;
                        endpoint-index <=> root.endpoint-index;
                        endpoint-selected(index) => { root.endpoint-selected(index); }
                        copy-address => { root.copy-address(); }
                        browser-result(opened) => { root.browser-result(opened); }
                    }
                }
            }
        }
    }

    confirmation := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 48px, 440px);
        height: confirm-layout.min-height;
        close-policy: no-auto-close;
        forward-focus: cancel-button;
        accessible-role: groupbox;
        accessible-label: root.closing ? Tr.l.confirm-close : Tr.l.confirm-stop;
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Tab || event.text == Key.Backtab {
                    if !root.busy {
                        if cancel-button.has-focus { confirm-button.focus(); }
                        else { cancel-button.focus(); }
                    }
                    return accept;
                }
                if event.text == Key.Escape && !root.busy {
                    root.cancel-interrupt();
                    return accept;
                }
                return reject;
            }
            Rectangle {
                background: Theme.surface;
                border-radius: 16px;
                border-width: 1px;
                border-color: Theme.border;
                drop-shadow-blur: 32px;
                drop-shadow-offset-y: 12px;
                drop-shadow-color: #00000040;
                confirm-layout := VerticalLayout {
                    padding: 28px;
                    spacing: 16px;
                    Body {
                        text: root.closing ? Tr.l.confirm-close : Tr.l.confirm-stop;
                        font-size: 20px;
                        font-weight: 650;
                    }
                    Hint { text: Tr.l.confirm-message; font-size: 14px; }
                    HorizontalLayout {
                        spacing: 12px;
                        cancel-button := ActionButton {
                            text: Tr.l.cancel;
                            available: !root.busy;
                            control-height: 44px;
                            horizontal-stretch: 1;
                            activated => { root.cancel-interrupt(); }
                        }
                        confirm-button := ActionButton {
                            kind: ButtonKind.danger;
                            text: root.busy ? Tr.l.busy : Tr.l.confirm;
                            available: !root.busy;
                            control-height: 44px;
                            horizontal-stretch: 1;
                            activated => { root.confirm-interrupt(); }
                        }
                    }
                }
            }
        }
    }

    about := PopupWindow {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - 48px, 440px);
        height: about-card.min-height;
        close-policy: no-auto-close;
        forward-focus: about-card;
        accessible-role: groupbox;
        accessible-label: Tr.l.about;
        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.hide-about();
                    return accept;
                }
                if event.text == Key.Tab || event.text == Key.Backtab {
                    about-card.focus-close();
                    return accept;
                }
                return reject;
            }
            about-card := AboutCard {
                product-name: root.product-name;
                product-version: root.product-version;
                product-description: root.product-description;
                close => { root.hide-about(); }
            }
        }
    }

    if root.opening-visible: Rectangle {
        background: Theme.paper;
        opacity: root.opening-opacity;
        accessible-role: none;
        animate opacity { duration: Theme.reduce-motion ? 0ms : 160ms; easing: ease-out; }
        VerticalLayout {
            alignment: center;
            spacing: 20px;
            HorizontalLayout {
                alignment: center;
                Wordmark {
                    name: root.product-name;
                    dots: root.wordmark-dots;
                    columns: root.wordmark-columns;
                    ink: Theme.accent;
                    unit: 6px;
                }
            }
            Hint { text: Tr.l.opening; horizontal-alignment: center; accessible-role: none; }
        }
    }
}
