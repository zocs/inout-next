import { ListView } from "std-widgets.slint";
import { Tr } from "text.slint";
import { Theme, Heading, Hint } from "theme.slint";

export struct TransferRow {
    path: string, kind: string, state: string, accounting: string,
    active: bool, failed: bool, progress: float, known-total: bool,
}

export component Transfers inherits Rectangle {
    in property <[TransferRow]> records;
    private property <length> item-height: 68px;
    min-height: layout.min-height;
    background: Theme.surface;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.border;

    layout := VerticalLayout {
        alignment: start;
        padding: 24px;
        spacing: 8px;
        Heading { text: Tr.l.transfers; font-size: 17px; }
        Hint { text: root.records.length == 0 ? Tr.l.no-transfers : Tr.l.transfer-hint; }
        if root.records.length > 0: ListView {
            preferred-height: min(4 * root.item-height, root.records.length * root.item-height);
            min-height: root.item-height;
            for record in root.records: Rectangle {
                height: root.item-height;
                accessible-role: list-item;
                accessible-label: record.path + ", " + record.kind + ", " + record.state + ", " + record.accounting;
                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 4px;
                    Text {
                        text: record.path;
                        overflow: elide;
                        font-size: 14px;
                        font-weight: 500;
                        color: Theme.ink;
                        accessible-role: none;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: record.kind + " · " + record.state;
                            font-size: 13px;
                            color: record.failed ? Theme.error : record.active ? Theme.accent : Theme.muted;
                            horizontal-stretch: 1;
                            overflow: elide;
                            accessible-role: none;
                        }
                        Text {
                            text: record.accounting;
                            horizontal-alignment: right;
                            font-size: 13px;
                            color: Theme.muted;
                            accessible-role: none;
                        }
                    }
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: record.active && record.known-total ? Theme.sunken : transparent;
                        Rectangle {
                            x: 0;
                            width: record.active && record.known-total ? parent.width * record.progress : 0;
                            height: parent.height;
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }
        }
    }
}
